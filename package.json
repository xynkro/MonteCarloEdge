{
  "name": "monte-carlo-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx src/engine/scripts/validate.ts",
    "validate-ranges": "tsx src/engine/scripts/validate-ranges.ts",
    "validate-decisions": "tsx src/engine/scripts/validate-decisions.ts",
    "self-play": "tsx src/engine/scripts/self-play.ts",
    "emu": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions --project montecarloedge",
    "validate:all": "npm run validate && npm run validate-ranges && npm run validate-decisions"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^9.0.1",
    "firebase": "^12.14.0",
    "morphdom": "^2.7.8"
  }
}
