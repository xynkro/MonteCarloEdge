rules_version = '2';
// MonteCarloEdge — Firestore security rules.
// Paste into Firebase Console → Firestore → Rules → Publish (or `firebase deploy --only firestore:rules`).
//
// Model: Cloud Functions (Admin SDK, bypasses rules) are the SOLE writer of all
// game + chip state. Clients read public projections + their OWN private hand,
// and may only touch a couple of non-authoritative presence fields.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // ── Presence lobby (Phase 1) ──
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ── Friendships ── one doc per pair (sorted uids). Functions are the SOLE writer
    // (sendFriendRequest / respondFriendRequest / removeFriend); a participant may read theirs.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    // ── Direct messages ── thread id = sorted-uid pair "a_b"; both participants read (Firebase uids
    // are alphanumeric, so split("_") yields exactly the two uids). Functions are the sole writer.
    match /dms/{thread}/messages/{msg} {
      allow read: if signedIn() && request.auth.uid in thread.split("_");
      allow write: if false;
    }

    // ── User profiles ──
    // HARDENED: a client may write ONLY `name`. chips + strategyEntitled are
    // server-authoritative (Cloud Functions only) so a client cannot mint
    // play-chips or unlock the paywalled strategy by writing its own doc.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.token.admin == true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff({}).affectedKeys().hasOnly(['name']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      // Inbox: messages + gift notes. You read ONLY your own; you may mark items read.
      // All creation (gifts/admin/messages) is Cloud-Function-only — clients can't
      // mint a gift by writing their own inbox.
      match /inbox/{msgId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if false;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Tables (Phase 2) ──
    match /tables/{tableId} {
      allow read: if signedIn();    // public projection = publicState() — NO hole cards
      allow write: if false;        // written only by Cloud Functions

      // The secret authority: deck + every player's holes + serialized engine.
      // No client may ever read or write anything under private/.
      match /private/{doc} {
        allow read, write: if false;
      }
      // Per-player private hand: you read ONLY your own; nobody writes from a client.
      match /hands/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      // Seat presence: everyone sees who's seated; you heartbeat ONLY your own
      // non-authoritative fields. Seat assignment / chips / sit-out are function-only.
      match /seats/{uid} {
        allow read: if signedIn();
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'connected']);
        allow create, delete: if false;
      }
      // Room chat — any signed-in user with the code can read; writes go through the
      // sendChat callable (rate-limited + length-checked there), never client-direct.
      match /chat/{msgId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Server-only rate-limit buckets.
    match /rateLimits/{uid} { allow read, write: if false; }

    // Passkeys (WebAuthn public keys) + single-use auth challenges. Written + read
    // ONLY by Cloud Functions (Admin SDK) — a client never touches these.
    match /passkeys/{credId} { allow read, write: if false; }
    match /passkeyChallenges/{id} { allow read, write: if false; }

    // Immutable chip-transfer audit trail. Written ONLY by Cloud Functions; readable
    // only by a super-admin (custom claim admin:true) so you can investigate gifts.
    match /ledger/{id} {
      allow read: if signedIn() && request.auth.token.admin == true;
      allow write: if false;
    }

    // Default deny. (Rule grants are additive and cannot be revoked by another
    // match, so this never overrides the specific allows above.)
    match /{document=**} { allow read, write: if false; }
  }
}
