rules_version = '2';
// MonteCarloEdge — Firestore security rules (Phase 1: auth + presence).
// Paste into Firebase Console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Presence: anyone signed in can SEE who's online; you can only write your own.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // User profiles: readable by signed-in users; you may create/update only your own.
    // (Chip balances become server-authoritative via Cloud Functions in Phase 3 —
    //  this rule will then forbid client writes to the `chips` field.)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Tables & hands are written ONLY by Cloud Functions (server-authoritative
    // dealing) — added in Phase 2. Until then, deny all client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
